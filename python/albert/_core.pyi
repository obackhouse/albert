from collections.abc import Callable, Sequence

from albert.metadata import Metadata as _Metadata
from albert.options import CostModel as _CostModel
from albert.options import NodeKind as _NodeKind
from albert.options import PhaseFactor as _PhaseFactor
from albert.options import SearchOrder as _SearchOrder

class CanonicalKey:
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class CostEstimate:
    multiplications: float
    additions: float
    reads: float
    writes: float
    total: float

class Node:
    kind: _NodeKind
    children: list[Node]
    external_indices: list[str]
    internal_indices: list[str]

    def search(
        self,
        predicate: Callable[[Node], bool],
        max_depth: int | None = None,
        order: _SearchOrder = _SearchOrder.PREORDER,
    ) -> list[Node]: ...
    def find(
        self,
        predicate: Callable[[Node], bool],
        max_depth: int | None = None,
        order: _SearchOrder = _SearchOrder.PREORDER,
    ) -> Node | None: ...
    def delete(
        self,
        predicate: Callable[[Node], bool],
        max_depth: int | None = None,
    ) -> Node: ...
    def apply(
        self,
        filter: Callable[[Node], Node],
        predicate: Callable[[Node], bool] | None = None,
        max_depth: int | None = None,
    ) -> Node: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def map_indices(self, mapping: dict[str, str]) -> Node: ...
    def permute_indices(self, permutation: Sequence[int] | Permutation) -> Node: ...
    def __add__(self, other: Node | float) -> Node: ...
    def __radd__(self, other: float) -> Node: ...
    def __sub__(self, other: Node | float) -> Node: ...
    def __rsub__(self, other: float) -> Node: ...
    def __mul__(self, other: Node | float) -> Node: ...
    def __rmul__(self, other: float) -> Node: ...
    def __pos__(self) -> Node: ...
    def __neg__(self) -> Node: ...

class Scalar(Node):
    value: float

    def __init__(self, value: float) -> None: ...

class Tensor(Node):
    symbol: str
    rank: int
    indices: list[str]

    def __init__(self, symbol: str, indices: Sequence[str]) -> None: ...

class Add(Node):
    arity: int
    children: list[Node]

    def __init__(self, children: Sequence[Node]) -> None: ...

class Mul(Node):
    arity: int
    children: list[Node]

    def __init__(self, children: Sequence[Node]) -> None: ...

class Expression:
    lhs: Tensor
    rhs: Node

    def __init__(self, lhs: Tensor, rhs: Node) -> None: ...

class Permutation:
    permutation: list[int]
    phase: _PhaseFactor

    def __init__(self, permutation: Sequence[int], phase: _PhaseFactor = _PhaseFactor.POSITIVE) -> None: ...

def canonical_key(node: Node) -> CanonicalKey: ...
def estimate_cost(node: Node, metadata: _Metadata, cost_model: _CostModel = ...) -> CostEstimate: ...
def canonicalize(node: Node, metadata: _Metadata | None = None) -> Node: ...
def expand(node: Node) -> Node: ...
def collect(node: Node) -> Node: ...
def squeeze(node: Node) -> Node: ...
def remove_neutral_elements(node: Node) -> Node: ...
def simplify(node: Node) -> Node: ...
